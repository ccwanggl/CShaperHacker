<Window
    x:Class="StaticDynamicResource.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StaticDynamicResource"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
	<Window.Resources>
		<TextBlock x:Key="textBlockName1" Text="Hello, World!" />
		<TextBlock x:Key="textBlockName2" Text="Hello, World!" />
	</Window.Resources>

	<StackPanel>
		<Button Content="{StaticResource textBlockName1}" />
		<Button Content="{DynamicResource textBlockName2}" />
		<Button
            Margin="5,5,5,0"
            Click="Button_Click"
            Content="Update" />
	</StackPanel>
</Window>
