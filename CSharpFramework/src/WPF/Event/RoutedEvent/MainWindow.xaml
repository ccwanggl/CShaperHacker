<Window
    x:Class="RoutedEvent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RoutedEvent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="200"
    Height="250"
    mc:Ignorable="d">
	<Grid x:Name="gridRoot" Background="Lime">
		<Grid
            x:Name="gridA"
            Margin="10"
            Background="Blue">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Canvas
                x:Name="canvasLeft"
                Grid.Column="0"
                Margin="10"
                Background="Red">
				<Button
                    x:Name="buttonLeft"
                    Width="40"
                    Height="100"
                    Margin="10"
                    Content="Left" />
			</Canvas>
			<Canvas
                x:Name="canvasRight"
                Grid.Column="1"
                Margin="10"
                Background="Yellow">
				<Button
                    x:Name="buttonRight"
                    Width="40"
                    Height="100"
                    Margin="10"
                    Content="Right" />
			</Canvas>
		</Grid>
	</Grid>
</Window>
