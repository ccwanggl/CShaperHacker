<Window
    x:Class="ContentControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ContentControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="1600"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ContentControl 族  -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Background="Yellow">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Button  -->
            <Button
                Grid.Row="0"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="CadetBlue"
                FontWeight="Black">
                <Button.Content>
                    <StackPanel>
                        <Image
                            Width="64"
                            Height="64"
                            Source=".\Hipo.png" />
                        <Label HorizontalAlignment="Center" Content="Settings" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <!--  ContentControl  -->
            <ContentControl Grid.Row="1" Content="ContentControl" />
            <!--  Label  -->
            <Label Grid.Row="2" Content="Label" />
            <!--  RadioButton  -->
            <RadioButton Grid.Row="3" Content="RadioButton" />
            <!--  ToggleButton  -->
            <ToggleButton Grid.Row="4" Content="ToggleButton" />
            <!--  UserControl  -->
            <UserControl Grid.Row="5" Content="UserControl" />
            <!--  CheckBox  -->
            <CheckBox Grid.Row="6" Content="CheckBox" />
            <!--  Frame  -->
            <Frame Grid.Row="7" Content="Frame" />
            <!--  RepeatButton  -->
            <RepeatButton Grid.Row="8" Content="RepeatButton" />
        </Grid>

        <!--  HeaderedContentControl 族  -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Background="Green">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Expander Grid.Row="0" Header="Expander">
                <Expander.Content>
                    <Button Content="Button" />
                </Expander.Content>
            </Expander>
            <GroupBox
                Grid.Row="1"
                Margin="10"
                BorderBrush="Red">
                <GroupBox.Header>
                    <Image
                        Width="32"
                        Height="32"
                        Source="Hipo.png" />
                </GroupBox.Header>
                <TextBox
                    Margin="10"
                    Text="一棵树、一匹马、一头大象和一只鸡在一起，打一种日常用品。"
                    TextWrapping="WrapWithOverflow" />
            </GroupBox>
            <HeaderedContentControl Grid.Row="2" Header="HeaderedContentControl">
                <HeaderedContentControl.Content>
                    <Button Content="Button" />
                </HeaderedContentControl.Content>
            </HeaderedContentControl>
            <TabItem Grid.Row="3" Header="TabItem">
                <TabItem.Content>
                    <Button Content="Button2" />
                </TabItem.Content>
            </TabItem>
        </Grid>
        <!--  ItemsControl 族  -->
        <ListBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Background="Beige" />

        <ListView
            Grid.Row="2"
            Grid.Column="0"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Background="Aqua">
            <ListView.View>
                <GridView>
                    <GridViewColumn />
                </GridView>
            </ListView.View>
        </ListView>
        <GridViewColumnHeader
            Grid.Row="1"
            Grid.Column="0"
            Content="GridViewColumnHeader" />
        <ScrollViewer />

        <HeaderedItemsControl
            Grid.Row="3"
            Grid.Column="0"
            Background="AliceBlue"
            Header="HeaderedItemsControl" />

        <Border Grid.Row="3" Grid.Column="1" />

        <!--  HeaderedItemsControl 族  -->
        <MenuItem Grid.Row="3" Grid.Column="1" />
        <!--  Decorator 族  -->
        <Border Grid.Row="4" Grid.Column="0" />

        <!--  Shape 族  -->
        <Rectangle
            Grid.Row="4"
            Grid.Column="1"
            Fill="Black" />
        <!--  Panel 族  -->
    </Grid>
</Window>
