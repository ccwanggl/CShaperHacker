<Window
    Height="700"
    Title="MainWindow"
    Width="700"
    mc:Ignorable="d"
    x:Class="PropertyAssignment.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Rectangle 1  -->
        <TextBlock Grid.Column="0" Text="标签的 Attribute 为对象属性赋值" />
        <Rectangle
            Fill="Blue"
            Grid.Column="0"
            Grid.Row="0"
            Height="120"
            Width="200"
            x:Name="Rectangle1" />

        <!--  Rectangle 2  以对象形式为属性赋值  -->
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="属性元素 1" />
        <Rectangle
            Grid.Column="1"
            Grid.Row="0"
            Height="120"
            Width="200"
            x:Name="Rectangle2">
            <Rectangle.Fill>
                <SolidColorBrush Color="Yellow" />
            </Rectangle.Fill>
        </Rectangle>

        <!--  Rectangle 3  以对象形式为属性赋值  -->
        <TextBlock
            Grid.Column="2"
            Grid.Row="0"
            Text="属性元素 2" />
        <Rectangle
            Grid.Column="2"
            Grid.Row="0"
            Height="120"
            Width="200"
            x:Name="Rectangle3">
            <Rectangle.Fill>
                <LinearGradientBrush>
                    <LinearGradientBrush.StartPoint>
                        <Point X="0" Y="0" />
                    </LinearGradientBrush.StartPoint>
                    <LinearGradientBrush.EndPoint>
                        <Point X="1" Y="1" />
                    </LinearGradientBrush.EndPoint>
                    <LinearGradientBrush.GradientStops>
                        <GradientStopCollection>
                            <GradientStop Color="LightBlue" Offset="0.2" />
                            <GradientStop Color="Blue" Offset="0.7" />
                            <GradientStop Color="DarkBlue" Offset="1.0" />
                        </GradientStopCollection>
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  椭圆  -->
        <Ellipse
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Grid.Row="1"
            Height="450"
            Width="450">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.25 0.25" RadiusX="0.75" RadiusY="0.75">
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="Black" Offset="0.65" />
                        <GradientStop Color="Gray" Offset="0.8" />
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Window>
