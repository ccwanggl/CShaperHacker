<Window
    x:Class="LayoutDockPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LayoutDockPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="400"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <TextBox
                Height="25"
                BorderBrush="Black"
                DockPanel.Dock="Top"
                Text="DockPanel" />
            <TextBox
                Width="150"
                BorderBrush="Black"
                DockPanel.Dock="Left" />
            <TextBox BorderBrush="Black" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.ColumnSpan="3"
                BorderBrush="Black"
                Text="GridSplitter" />
            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black" />
            <GridSplitter
                Grid.Row="1"
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Gray"
                ShowsPreview="True" />
            <TextBox
                Grid.Row="1"
                Grid.Column="2"
                BorderBrush="Black" />

        </Grid>
    </Grid>
</Window>
