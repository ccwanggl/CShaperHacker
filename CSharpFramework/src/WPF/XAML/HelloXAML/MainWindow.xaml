<!--  xmlns[:可选映射前缀]=“名称空间“  -->
<!--  默认名称空间只能有一个  -->
<!--  特征：针对语言层面    属性：针对抽象对象; 特征和属性的对应问题  -->
<Window
    Height="350"
    Title="MainWindow"
    Width="800"
    mc:Ignorable="d"
    x:Class="HelloXAML.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelloXAML"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Goldenrod">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Background="LightSlateGray"
            Grid.Row="0"
            Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <TextBox
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                Margin="5"
                x:Name="textBoxl" />
            <TextBox
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Margin="5"
                x:Name="textBox2" />
            <TextBox
                Grid.Column="0"
                Grid.ColumnSpan="1"
                Grid.Row="2"
                Margin="5"
                x:Name="textBox3" />
            <TextBox
                Grid.Column="1"
                Grid.ColumnSpan="1"
                Grid.Row="2"
                Margin="5"
                x:Name="textBox4" />
            <Button
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                Margin="5"
                x:Name="button1">
                <Image
                    Height="23"
                    Source=".\btn1.png"
                    Width="23" />
            </Button>
        </Grid>

        <StackPanel
            Background="Chocolate"
            Grid.Row="1"
            Margin="20">
            <TextBox Margin="5" x:Name="TextBox11" />
            <TextBox Margin="5" x:Name="TextBox22" />
            <StackPanel Orientation="Horizontal">
                <TextBox
                    Margin="5"
                    Width="390"
                    x:Name="TextBox33" />
                <TextBox
                    Margin="5"
                    Width="390"
                    x:Name="TextBox44" />
            </StackPanel>
            <Button Margin="5" x:Name="Button11">
                <Image
                    Height="23"
                    Source="btn2.png"
                    Width="23" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
