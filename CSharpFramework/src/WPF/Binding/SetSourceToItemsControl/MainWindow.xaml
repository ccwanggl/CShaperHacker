<Window
    x:Class="SetSourceToItemsControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SetSourceToItemsControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="stackPanel1"
            Grid.Row="0"
            Margin="5"
            Background="LightCyan">
            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Student ID" />
            <TextBox x:Name="textBoxId1" Margin="5" />
            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Student List:" />
            <ListBox
                x:Name="listBoxStudents1"
                Height="110"
                Margin="5" />

        </StackPanel>
        <StackPanel
            x:Name="stackPanel2"
            Grid.Row="1"
            Margin="5"
            Background="LightBlue">
            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Student ID" />
            <TextBox x:Name="textBoxId2" Margin="5" />
            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Student List:" />
            <ListBox
                x:Name="listBoxStudents2"
                Height="110"
                Margin="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="30" Text="{Binding Path=Id}" />
                            <TextBlock Width="60" Text="{Binding Path=Name}" />
                            <TextBlock Width="30" Text="{Binding Path=Age}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Grid>
</Window>
