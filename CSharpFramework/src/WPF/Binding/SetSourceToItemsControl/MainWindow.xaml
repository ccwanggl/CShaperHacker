<Window
    x:Class="SetSourceToItemsControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SetSourceToItemsControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <StackPanel x:Name="stackPanel" Background="LightBlue">
        <TextBlock
            Margin="5"
            FontWeight="Bold"
            Text="Student ID" />
        <TextBox x:Name="textBoxId" Margin="5" />
        <TextBlock
            Margin="5"
            FontWeight="Bold"
            Text="Student List:" />
        <ListBox
            x:Name="listBoxStudents"
            Height="110"
            Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="30" Text="{Binding Path=Id}" />
                        <TextBlock Width="60" Text="{Binding Path=Name}" />
                        <TextBlock Width="30" Text="{Binding Path=Age}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</Window>
