<Window
    x:Class="MultiBinding.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MultiBinding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
	<Window.Resources>
		<local:ButtonStateConverter x:Key="ButtonStateConverter" />
	</Window.Resources>
	<Window.DataContext>
		<local:ViewModel />
	</Window.DataContext>
	<StackPanel>
		<Button Content="Click Me">
			<Button.IsEnabled>
				<MultiBinding Converter="{StaticResource ButtonStateConverter}">
					<Binding Path="Condition1" />
					<Binding Path="Condition2" />
				</MultiBinding>
			</Button.IsEnabled>
		</Button>

		<Button Click="Button_Click" Content="Test" />
	</StackPanel>
</Window>
