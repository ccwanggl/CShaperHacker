<Window
    x:Class="NoSourceBindingDataContextAsSource.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NoSourceBindingDataContextAsSource"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Title="Datacontext as source"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="Azure">
            <StackPanel.DataContext>
                <local:Student
                    Name="Tim"
                    Age="29"
                    Id="6" />
            </StackPanel.DataContext>
            <Grid>
                <StackPanel>
                    <TextBox Margin="5" Text="{Binding Path=Id}" />
                    <TextBox Margin="5" Text="{Binding Path=Name}" />
                    <TextBox Margin="5" Text="{Binding Path=Age}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Background="Beige">
            <StackPanel.DataContext>
                <local:Student
                    Name="Tim"
                    Age="29"
                    Id="6" />
            </StackPanel.DataContext>
            <Grid>
                <StackPanel>
                    <TextBox Margin="5" Text="{Binding Id}" />
                    <TextBox Margin="5" Text="{Binding Name}" />
                    <TextBox Margin="5" Text="{Binding Age}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Background="Bisque">
            <StackPanel.DataContext>
                <system:String>Hello DataContext [Text="{Binding Path=.}"]!</system:String>
            </StackPanel.DataContext>
            <Grid>
                <StackPanel>
                    <TextBox Margin="5" Text="{Binding Path=.}" />
                    <TextBox Margin="5" Text="{Binding Path=.}" />
                    <TextBox Margin="5" Text="{Binding Path=.}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Background="Cornsilk">
            <StackPanel.DataContext>
                <system:String>Hello DataContext [Text="{Binding}"]!</system:String>
            </StackPanel.DataContext>
            <Grid>
                <StackPanel>
                    <TextBlock Margin="5" Text="{Binding}" />
                    <TextBlock Margin="5" Text="{Binding}" />
                    <TextBlock Margin="5" Text="{Binding}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
