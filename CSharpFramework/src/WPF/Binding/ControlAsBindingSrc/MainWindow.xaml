<Window
    x:Class="ControlAsBindingSrc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlAsBindingSrc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Control as Source"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="Azure">
            <!--  Binding 扩展语法  -->
            <!--  为 xxx 属性设置 Binding 为 ......  -->
            <TextBox
                Margin="5"
                BorderBrush="Black"
                Text="{Binding Path=Value, ElementName=Slider1}" />
            <Slider
                x:Name="Slider1"
                Margin="5"
                Maximum="100"
                Minimum="0"
                Value="10" />
        </StackPanel>

        <StackPanel Grid.Row="1" Background="Cornsilk">
            <TextBox
                x:Name="TextBox2"
                Margin="5"
                BorderBrush="Black" />
            <Slider
                x:Name="Slider2"
                Margin="5"
                Maximum="100"
                Minimum="0" />

        </StackPanel>
        <StackPanel Grid.Row="2" Background="Linen">
            <!--  Binding 可以接收 Path 作为参数  -->
            <TextBox
                Margin="5"
                BorderBrush="Black"
                Text="{Binding Value, ElementName=Slider3}" />
            <Slider
                x:Name="Slider3"
                Margin="5"
                Maximum="100"
                Minimum="0" />

        </StackPanel>
    </Grid>
</Window>
