<Window
    x:Class="HelloDataTemplate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelloDataTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
	<Window.Resources>
		<local:AutomakerToLogoPathConverter x:Key="a2l" />
		<local:NameToPhotoPathConverter x:Key="n2p" />
		<DataTemplate x:Key="carDetailViewTemplate">
			<Border
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="6">
				<StackPanel Margin="5">
					<Image
                        Width="400"
                        Height="250"
                        Source="{Binding Name, Converter={StaticResource n2p}}" />
					<StackPanel Margin="5,0" Orientation="Horizontal">
						<TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Text="Name:" />
						<TextBlock
                            Margin="5,0"
                            FontSize="20"
                            Text="{Binding Name}" />
					</StackPanel>
					<StackPanel Margin="5,0" Orientation="Horizontal">
						<TextBlock FontWeight="Bold" Text="Automaker:" />
						<TextBlock Margin="5,0" Text="{Binding Automaker}" />
						<TextBlock FontWeight="Bold" Text="Year:" />
						<TextBlock Margin="5,0" Text="{Binding Year}" />
						<TextBlock FontWeight="Bold" Text="Top Speed:" />
						<TextBlock Margin="5,0" Text="{Binding TopSpeed}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="carListItemViewTemplate">
			<Grid Margin="2">
				<StackPanel Orientation="Horizontal">
					<Image
                        Grid.RowSpan="3"
                        Width="64"
                        Height="64"
                        Source="{Binding Automaker, Converter={StaticResource a2l}}" />
					<StackPanel Margin="5,0">
						<TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{Binding Name}" />
						<TextBlock FontSize="14" Text="{Binding Year}" />
					</StackPanel>
				</StackPanel>
			</Grid>
		</DataTemplate>
	</Window.Resources>
	<StackPanel Margin="5" Orientation="Horizontal">
		<UserControl Content="{Binding SelectedItem, ElementName=listBoxCars}" ContentTemplate="{StaticResource carDetailViewTemplate}" />
		<ListBox
            x:Name="listBoxCars"
            Width="180"
            Margin="5,0"
            ItemTemplate="{StaticResource carListItemViewTemplate}" />
	</StackPanel>
</Window>
