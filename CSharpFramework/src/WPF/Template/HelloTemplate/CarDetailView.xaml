<UserControl
    x:Class="HelloTemplate.CarDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HelloTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<Border
        BorderBrush="Black"
        BorderThickness="1"
        CornerRadius="5">
		<StackPanel Margin="5">
			<Image
                x:Name="imagePhoto"
                Width="400"
                Height="250" />
			<StackPanel Margin="5,0" Orientation="Horizontal">
				<TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Name:" />
				<TextBlock
                    x:Name="textBlockName"
                    Margin="5,0"
                    FontSize="20" />
			</StackPanel>
			<StackPanel Margin="5,0" Orientation="Horizontal">
				<TextBlock FontWeight="Bold" Text="Automaker:" />
				<TextBlock x:Name="textBlockAutomaker" Margin="5,0" />
				<TextBlock
                    Margin="10,0"
                    FontWeight="Bold"
                    Text="Year:" />
				<TextBlock x:Name="textBlockYear" Margin="5,0" />
				<TextBlock FontWeight="Bold" Text="Top Speed:" />
				<TextBlock x:Name="textBlockTopSpeed" Margin="5,0" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
